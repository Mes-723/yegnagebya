# Example Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL Database URL
# For Local Development:
#   Option 1: Install PostgreSQL locally
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
#
#   Option 2: Use Railway's database (requires public endpoint)
#   DATABASE_URL=postgresql://postgres:cZOahYUEBQVIhWBbSyjioGRXgGOnASci@[public-host]:[port]/railway
#
# For Production on Railway:
#   Railway automatically sets DATABASE_URL to postgres.railway.internal
#   No action needed - Railway will inject this

DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# JWT Secret - Generate a strong random string for production
JWT_SECRET=your_jwt_secret_here_generate_a_long_random_string

# Cloudinary Image Upload Service
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server Configuration
PORT=3000
NODE_ENV=development
